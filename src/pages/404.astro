---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/icons/Icon.astro";
---

<Layout
	title="Page Not Found"
	description="This page doesn't exist — but here's how to find what you're looking for on Bull or Bear Blogs."
	noIndex
>
	<section class="mx-auto flex max-w-xl flex-col items-center px-5 py-24 text-center sm:px-6">
		<span class="text-sm font-bold uppercase tracking-wide text-primary">404</span>
		<h1 class="mt-3 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">Page not found</h1>
		<p class="mt-4 text-lg text-mute">
			The page you're looking for has moved, been renamed, or never existed. Let's get you back on track.
		</p>
		<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
			<a
				href="/"
				class="inline-flex h-12 items-center rounded-full bg-primary px-6 text-sm font-bold text-white transition-colors hover:bg-primary-pressed"
			>
				Back to homepage
			</a>
			<a
				href="/search/"
				class="inline-flex h-12 items-center gap-2 rounded-full bg-surface-card px-6 text-sm font-bold text-ink transition-colors hover:bg-surface-card/70"
			>
				<Icon name="search" class="h-4 w-4" />
				Search articles
			</a>
		</div>
	</section>
</Layout>
