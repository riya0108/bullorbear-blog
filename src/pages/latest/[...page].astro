---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import Icon from "../../components/icons/Icon.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
	const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return paginate(posts, { pageSize: 9 });
}

const { page } = Astro.props as Awaited<ReturnType<typeof getStaticPaths>>[number]["props"];
---

<Layout title="Latest" description="The newest reads from Bull or Bear Blogs, freshest first.">
	<Breadcrumbs items={[{ name: "Latest" }]} />

	<section class="mx-auto max-w-[1600px] px-5 pb-6 pt-14 sm:px-6 sm:pt-20 lg:px-10 xl:px-16">
		<h1 class="text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">Latest</h1>
		<p class="mt-3 max-w-xl text-lg text-mute">Every article, freshest first.</p>
	</section>

	<section class="mx-auto max-w-[1600px] px-5 py-8 sm:px-6 lg:px-10 xl:px-16">
		<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
			{page.data.map((post, i) => <PostCard post={post} delay={i * 60} />)}
		</div>

		<nav class="mt-12 flex items-center justify-between" aria-label="Pagination">
			{
				page.url.prev ? (
					<a href={page.url.prev} class="inline-flex items-center gap-1.5 rounded-full bg-surface-card px-5 py-2.5 text-sm font-bold text-ink hover:bg-secondary-bg">
						<Icon name="arrow-right" class="h-4 w-4 rotate-180" />
						Newer
					</a>
				) : <span />
			}
			<span class="text-sm text-mute">Page {page.currentPage} of {page.lastPage}</span>
			{
				page.url.next ? (
					<a href={page.url.next} class="inline-flex items-center gap-1.5 rounded-full bg-surface-card px-5 py-2.5 text-sm font-bold text-ink hover:bg-secondary-bg">
						Older
						<Icon name="arrow-right" class="h-4 w-4" />
					</a>
				) : <span />
			}
		</nav>
	</section>
</Layout>
