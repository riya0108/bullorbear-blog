---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/icons/Icon.astro";
import { CALCULATORS, CALCULATOR_CATEGORIES } from "../../lib/calculators/registry";
---

<Layout
	title="Financial Calculators"
	description="Free, accurate SIP, EMI, tax, PPF, FD, and other financial calculators for Indian investors."
>
	<section class="mx-auto max-w-[1600px] px-5 pb-6 pt-14 sm:px-6 sm:pt-20 lg:px-10 xl:px-16">
		<div class="flex items-center gap-3">
			<span class="grid h-12 w-12 place-items-center rounded-full bg-surface-card text-primary">
				<Icon name="calculator" class="h-6 w-6" />
			</span>
			<h1 class="text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">Calculators</h1>
		</div>
		<p class="mt-3 max-w-xl text-lg text-mute">
			Plan your investments, loans, taxes, and trades with free, accurate calculators — built for Indian investors.
		</p>
	</section>

	<section class="mx-auto max-w-[1600px] px-5 pb-16 sm:px-6 lg:px-10 xl:px-16">
		<div class="flex flex-col gap-12">
			{
				CALCULATOR_CATEGORIES.map((category) => (
					<div>
						<h2 class="mb-4 text-xl font-bold text-ink">{category}</h2>
						<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
							{CALCULATORS.filter((c) => c.category === category).map((calc) => (
								<a
									href={`/calculators/${calc.slug}/`}
									class="group flex flex-col gap-2 rounded-2xl bg-surface-card p-5 transition-transform duration-300 hover:-translate-y-1"
								>
									<span class="text-base font-bold text-ink">{calc.name}</span>
									<span class="text-sm text-mute">{calc.description}</span>
									<span class="mt-1 inline-flex items-center gap-1 text-sm font-bold text-primary transition-[gap] duration-200 group-hover:gap-2">
										Calculate
										<Icon name="arrow-right" class="h-4 w-4" />
									</span>
								</a>
							))}
						</div>
					</div>
				))
			}
		</div>
	</section>
</Layout>
