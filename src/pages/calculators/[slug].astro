---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/icons/Icon.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { CALCULATORS, getCalculatorMeta } from "../../lib/calculators/registry";
import { CALCULATOR_CONTENT } from "../../lib/calculators/content";

import SipCalculator from "../../components/react/calculators/SipCalculator";
import StepUpSipCalculator from "../../components/react/calculators/StepUpSipCalculator";
import LumpsumCalculator from "../../components/react/calculators/LumpsumCalculator";
import SwpCalculator from "../../components/react/calculators/SwpCalculator";
import MfReturnsCalculator from "../../components/react/calculators/MfReturnsCalculator";
import PpfCalculator from "../../components/react/calculators/PpfCalculator";
import RdCalculator from "../../components/react/calculators/RdCalculator";
import FdCalculator from "../../components/react/calculators/FdCalculator";
import EpfCalculator from "../../components/react/calculators/EpfCalculator";
import SsyCalculator from "../../components/react/calculators/SsyCalculator";
import RoiCalculator from "../../components/react/calculators/RoiCalculator";
import EmiCalculator from "../../components/react/calculators/EmiCalculator";
import IncomeTaxCalculator from "../../components/react/calculators/IncomeTaxCalculator";
import HraCalculator from "../../components/react/calculators/HraCalculator";
import SalaryCalculator from "../../components/react/calculators/SalaryCalculator";
import GstCalculator from "../../components/react/calculators/GstCalculator";
import TdsCalculator from "../../components/react/calculators/TdsCalculator";
import BrokerageCalculator from "../../components/react/calculators/BrokerageCalculator";
import MarginCalculator from "../../components/react/calculators/MarginCalculator";
import StockAverageCalculator from "../../components/react/calculators/StockAverageCalculator";

export function getStaticPaths() {
	return CALCULATORS.map((calc) => ({ params: { slug: calc.slug } }));
}

const { slug } = Astro.params;
const meta = getCalculatorMeta(slug!)!;
const content = CALCULATOR_CONTENT[slug!];
---

<Layout title={meta.name} description={meta.description}>
	<Breadcrumbs items={[{ name: "Calculators", url: "/calculators/" }, { name: meta.name }]} />

	<section class="mx-auto max-w-[1600px] px-5 pb-6 pt-14 sm:px-6 sm:pt-20 lg:px-10 xl:px-16">
		<a href="/calculators/" class="mb-4 inline-flex items-center gap-1 text-sm font-bold text-mute hover:text-ink">
			<Icon name="arrow-right" class="h-4 w-4 rotate-180" />
			All calculators
		</a>
		<h1 class="text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">{meta.name}</h1>
		<p class="mt-3 max-w-2xl text-lg text-mute">{meta.description}</p>
	</section>

	<section class="mx-auto max-w-[1600px] px-5 pb-16 sm:px-6 lg:px-10 xl:px-16">
		{slug === "sip-calculator" && <SipCalculator client:load />}
		{slug === "step-up-sip-calculator" && <StepUpSipCalculator client:load />}
		{slug === "lumpsum-calculator" && <LumpsumCalculator client:load />}
		{slug === "swp-calculator" && <SwpCalculator client:load />}
		{slug === "mf-returns-calculator" && <MfReturnsCalculator client:load />}
		{slug === "ppf-calculator" && <PpfCalculator client:load />}
		{slug === "rd-calculator" && <RdCalculator client:load />}
		{slug === "fd-calculator" && <FdCalculator client:load />}
		{slug === "epf-calculator" && <EpfCalculator client:load />}
		{slug === "ssy-calculator" && <SsyCalculator client:load />}
		{slug === "roi-calculator" && <RoiCalculator client:load />}
		{slug === "emi-calculator" && <EmiCalculator client:load />}
		{slug === "home-loan-emi-calculator" && (
			<EmiCalculator client:load defaultLoanAmount={2500000} defaultRate={8.5} defaultYears={20} loanLabel="Home loan amount" />
		)}
		{slug === "car-loan-emi-calculator" && (
			<EmiCalculator client:load defaultLoanAmount={800000} defaultRate={9.5} defaultYears={7} loanLabel="Car loan amount" />
		)}
		{slug === "income-tax-calculator" && <IncomeTaxCalculator client:load />}
		{slug === "hra-calculator" && <HraCalculator client:load />}
		{slug === "salary-calculator" && <SalaryCalculator client:load />}
		{slug === "gst-calculator" && <GstCalculator client:load />}
		{slug === "tds-calculator" && <TdsCalculator client:load />}
		{slug === "brokerage-calculator" && <BrokerageCalculator client:load />}
		{slug === "margin-calculator" && <MarginCalculator client:load />}
		{slug === "stock-average-calculator" && <StockAverageCalculator client:load />}
	</section>

	{
		content && (
			<section class="mx-auto max-w-3xl px-5 pb-20 sm:px-6 lg:px-10 xl:px-16">
				<div class="flex flex-col gap-6 border-t border-hairline pt-10">
					<div>
						<h2 class="text-xl font-bold text-ink">How it works</h2>
						<p class="mt-2 text-body">{content.intro}</p>
					</div>
					<div class="rounded-2xl bg-surface-card p-5">
						<p class="mb-2 text-xs font-bold uppercase tracking-wide text-mute">Formula</p>
						<ul class="flex flex-col gap-1.5">
							{content.formula.map((line) => (
								<li class="font-mono text-sm text-body">{line}</li>
							))}
						</ul>
					</div>
					{content.faqs.length > 0 && (
						<div>
							<h2 class="text-xl font-bold text-ink">FAQs</h2>
							<div class="mt-3 flex flex-col gap-4">
								{content.faqs.map((faq) => (
									<div>
										<p class="font-bold text-ink">{faq.q}</p>
										<p class="mt-1 text-body">{faq.a}</p>
									</div>
								))}
							</div>
						</div>
					)}
				</div>
			</section>
		)
	}
</Layout>
