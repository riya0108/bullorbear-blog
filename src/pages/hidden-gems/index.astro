---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/icons/Icon.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { hiddenGems } from "../../data/hiddenGems";
---

<Layout
	title="Hidden Gems"
	description="Small, useful, underrated websites we've actually used — starting with a free live invoice editor with no signup and no watermark."
>
	<Breadcrumbs items={[{ name: "Hidden Gems" }]} />

	<section class="mx-auto max-w-[900px] px-5 pb-4 pt-14 sm:px-6 sm:pt-20">
		<p class="reveal inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wide text-mute">
			<Icon name="gem" class="h-4 w-4 text-primary" />
			Small, useful, easy to miss
		</p>
		<h1 class="reveal mt-1 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl" data-reveal-delay="60">
			Pretty Useful Websites (Hidden Treasures)
		</h1>
		<p class="reveal mt-3 max-w-xl text-lg text-mute" data-reveal-delay="100">
			Tools that quietly do their one job better than anything else out there — and somehow never
			rank for it. We only add a site here once we've actually used it ourselves.
		</p>
	</section>

	<section class="mx-auto max-w-[1300px] px-5 py-8 sm:px-6 sm:py-10" aria-label="All hidden gems">
		<div class="grid grid-cols-1 gap-6 lg:grid-cols-2 xl:grid-cols-3">
			{
				hiddenGems.map((gem, i) => {
					const { hostname } = new URL(gem.url);
					return (
						<article class="reveal reveal-pop flex flex-col overflow-hidden rounded-[1.75rem] border border-hairline bg-surface-card" data-reveal-delay={(i % 9) * 80}>
							<a
								href={gem.url}
								target="_blank"
								rel="noopener noreferrer"
								class="gem-preview group relative block border-b border-hairline bg-canvas"
								aria-label={`Open the live preview of ${gem.name} in a new tab`}
							>
								<div class="flex items-center gap-1.5 border-b border-hairline bg-surface-card px-3 py-2">
									<span class="h-2.5 w-2.5 rounded-full bg-bear/60" />
									<span class="h-2.5 w-2.5 rounded-full bg-primary/50" />
									<span class="h-2.5 w-2.5 rounded-full bg-bull/60" />
									<span class="ml-2 truncate rounded-full bg-canvas px-2.5 py-0.5 text-[11px] font-semibold text-mute">
										{hostname}
									</span>
								</div>
								<div class="gem-preview__frame">
									<iframe
										src={gem.url}
										title={`Live preview of ${gem.name}`}
										loading="lazy"
										tabindex="-1"
										aria-hidden="true"
										class="gem-preview__iframe"
									/>
								</div>
								<div class="gem-preview__overlay">
									<span class="inline-flex items-center gap-1.5 rounded-full bg-ink px-4 py-2 text-xs font-bold text-canvas">
										Open live preview
										<Icon name="arrow-right" class="h-3.5 w-3.5" />
									</span>
								</div>
							</a>

							<div class="flex flex-1 flex-col p-6">
								<div class="flex flex-wrap gap-1.5">
									{gem.tags.map((tag) => (
										<span class="rounded-full bg-canvas px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-mute">
											{tag}
										</span>
									))}
								</div>

								<h2 class="mt-3 text-lg font-extrabold text-ink">{gem.name}</h2>
								<p class="mt-1 text-sm font-semibold text-primary">{gem.tagline}</p>
								<p class="mt-3 text-sm leading-relaxed text-mute">{gem.description}</p>

								<div class="mt-4 rounded-2xl bg-canvas p-4">
									<p class="text-[11px] font-bold uppercase tracking-wide text-mute">Why it's underrated</p>
									<p class="mt-1.5 text-sm leading-relaxed text-body">{gem.whyUnderrated}</p>
								</div>

								<a
									href={gem.url}
									target="_blank"
									rel="noopener noreferrer"
									class="mt-5 inline-flex items-center justify-center gap-1.5 rounded-full bg-primary px-5 py-2.5 text-sm font-bold text-white transition-opacity hover:opacity-90"
								>
									Try {gem.name}
									<Icon name="arrow-right" class="h-4 w-4" />
								</a>
							</div>
						</article>
					);
				})
			}
		</div>
	</section>
</Layout>

<style>
	.gem-preview__frame {
		position: relative;
		width: 100%;
		padding-top: 62%;
		overflow: hidden;
	}

	.gem-preview__iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 294%;
		height: 294%;
		border: 0;
		transform: scale(0.34);
		transform-origin: 0 0;
		pointer-events: none;
	}

	.gem-preview__overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		background: color-mix(in srgb, var(--color-ink) 45%, transparent);
		transition: opacity 0.2s ease;
	}

	.gem-preview:hover .gem-preview__overlay,
	.gem-preview:focus-visible .gem-preview__overlay {
		opacity: 1;
	}

	@media (max-width: 640px) {
		.gem-preview__overlay {
			opacity: 1;
			background: color-mix(in srgb, var(--color-ink) 22%, transparent);
		}
	}
</style>
