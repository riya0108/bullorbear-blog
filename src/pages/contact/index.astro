---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
---

<Layout title="Contact" description="Get in touch with the Bull or Bear Blogs team.">
	<Breadcrumbs items={[{ name: "Contact" }]} />

	<section class="mx-auto max-w-xl px-5 py-16 sm:px-6 sm:py-20">
		<h1 class="text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">Get in touch</h1>
		<p class="mt-4 text-lg text-mute">
			Tips, corrections, pitches, or partnership questions — send them our way.
		</p>

		<form id="contact-form" class="mt-8 space-y-4" novalidate>
			<div>
				<label for="name" class="text-sm font-bold text-ink">Name</label>
				<input
					id="name"
					name="name"
					type="text"
					required
					class="mt-1.5 h-12 w-full rounded-xl bg-surface-card px-4 text-sm text-ink placeholder:text-ash focus:outline-none"
				/>
			</div>
			<div>
				<label for="email" class="text-sm font-bold text-ink">Email</label>
				<input
					id="email"
					name="email"
					type="email"
					required
					aria-describedby="email-error"
					class="mt-1.5 h-12 w-full rounded-xl border-2 border-transparent bg-surface-card px-4 text-sm text-ink placeholder:text-ash focus:outline-none aria-invalid:border-error-deep"
				/>
				<p id="email-error" class="email-error mt-1.5 hidden text-xs font-semibold text-error-deep" role="alert">
					Enter a valid email address (e.g. you@example.com).
				</p>
			</div>
			<div>
				<label for="message" class="text-sm font-bold text-ink">Message</label>
				<textarea
					id="message"
					name="message"
					required
					rows="5"
					class="mt-1.5 w-full rounded-xl bg-surface-card px-4 py-3 text-sm text-ink placeholder:text-ash focus:outline-none"
				></textarea>
			</div>
			<button
				type="submit"
				class="h-12 rounded-full bg-primary px-8 text-sm font-bold text-white transition-colors hover:bg-primary-pressed"
			>
				Send message
			</button>
		</form>
		<p id="contact-success" class="mt-6 hidden rounded-2xl bg-surface-card p-4 text-sm font-semibold text-ink">
			Thanks — we'll get back to you soon.
		</p>

		<p class="mt-10 text-sm text-mute">
			Prefer email? Write to us directly at
			<a href="mailto:bullorbearstrategies@gmail.com" class="font-semibold text-ink underline"
				>bullorbearstrategies@gmail.com</a
			>.
		</p>
	</section>
</Layout>

<script>
	const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
	const CONTACT_ENDPOINT =
		"https://script.google.com/macros/s/AKfycbwVQ1XAF4dGfZtad8iHlg5uoLhFPJKklMtDEtAkM0PhdKExBw03c2PxOHzNpVBJDUpuCg/exec";

	const form = document.getElementById("contact-form") as HTMLFormElement | null;
	const nameInput = document.getElementById("name") as HTMLInputElement | null;
	const emailInput = document.getElementById("email") as HTMLInputElement | null;
	const messageInput = document.getElementById("message") as HTMLTextAreaElement | null;
	const emailError = document.querySelector<HTMLElement>(".email-error");
	const submitButton = form?.querySelector<HTMLButtonElement>("button[type=submit]");

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		const value = emailInput?.value.trim() ?? "";

		if (!EMAIL_PATTERN.test(value)) {
			emailError?.classList.remove("hidden");
			emailInput?.setAttribute("aria-invalid", "true");
			emailInput?.focus();
			return;
		}

		emailError?.classList.add("hidden");
		emailInput?.removeAttribute("aria-invalid");
		submitButton?.setAttribute("disabled", "true");

		try {
			await fetch(CONTACT_ENDPOINT, {
				method: "POST",
				body: JSON.stringify({
					name: nameInput?.value.trim() ?? "",
					email: value,
					message: messageInput?.value.trim() ?? "",
				}),
			});
			form.classList.add("hidden");
			document.getElementById("contact-success")?.classList.remove("hidden");
		} catch {
			if (emailError) {
				emailError.textContent = "Something went wrong. Please try again.";
				emailError.classList.remove("hidden");
			}
			submitButton?.removeAttribute("disabled");
		}
	});

	emailInput?.addEventListener("input", () => {
		if (!emailError?.classList.contains("hidden")) {
			emailError?.classList.add("hidden");
			emailInput.removeAttribute("aria-invalid");
		}
	});
</script>
