---
import Layout from "../layouts/Layout.astro";
import CategoryCard from "../components/CategoryCard.astro";
import PostCard from "../components/PostCard.astro";
import InfographicStrip from "../components/InfographicStrip.astro";
import InfographicGallery from "../components/InfographicGallery.astro";
import AlsoCheckOut from "../components/AlsoCheckOut.astro";
import Icon from "../components/icons/Icon.astro";
import { getCollection } from "astro:content";

const categories = await getCollection("categories");
const allPosts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latestPosts = allPosts.slice(0, 9);
const trendingPosts = allPosts.filter((p) => p.data.trending);

const displayedIds = new Set([...latestPosts, ...trendingPosts].map((p) => p.id));
const archivePosts = allPosts.filter((p) => !displayedIds.has(p.id));
const alsoCheckOutPosts = archivePosts.slice(-6);
---

<Layout
	title="Bull or Bear Blogs"
	description="Independent reads on AI, tech, money, finance, politics, and personal finance — for readers who think in both directions."
>
	<section class="mx-auto max-w-5xl px-5 pb-6 pt-10 text-center sm:px-6 sm:pt-14">
		<p class="reveal inline-flex items-center gap-2 rounded-full bg-surface-card px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-mute">
			<span class="h-2 w-2 rounded-full bg-bull"></span>
			New reads, every week
		</p>
		<h1
			class="reveal mt-4 text-3xl font-extrabold leading-[1.1] tracking-tight text-ink sm:text-4xl lg:text-5xl"
			data-reveal-delay="80"
		>
			Unwrapping <span class="text-primary">the World</span>
		</h1>
		<p class="reveal mx-auto mt-3 max-w-xl text-sm text-mute sm:text-base" data-reveal-delay="160">
			Independent, no-nonsense coverage of AI, tech, money, finance, politics, and personal
			finance — written for readers who'd rather understand the move than chase the headline.
		</p>
	</section>

	<section
		class="mx-auto max-w-[1600px] px-5 py-10 sm:px-6 sm:py-14 lg:px-10 xl:px-16"
		aria-labelledby="latest-heading"
	>
		<div class="flex items-end justify-between gap-4">
			<h2 id="latest-heading" class="text-2xl font-extrabold text-ink sm:text-3xl">Latest</h2>
			<a href="/latest/" class="inline-flex items-center gap-1 text-sm font-bold text-ink hover:text-primary">
				View all
				<Icon name="arrow-right" class="h-4 w-4" />
			</a>
		</div>
		<div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
			{latestPosts.map((post, i) => <PostCard post={post} featured={i === 0} delay={i * 60} />)}
		</div>
	</section>

	<section
		class="mx-auto max-w-[1600px] px-5 py-10 sm:px-6 sm:py-14 lg:px-10 xl:px-16"
		aria-labelledby="topics-heading"
	>
		<div class="flex items-end justify-between gap-4">
			<h2 id="topics-heading" class="text-2xl font-extrabold text-ink sm:text-3xl">Explore by topic</h2>
		</div>
		<div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
			{categories.map((cat, i) => <CategoryCard category={cat} delay={i * 60} />)}
		</div>
	</section>

	{
		trendingPosts.length > 0 && (
			<section class="py-10 sm:py-14" aria-labelledby="trending-heading">
				<div class="mx-auto flex max-w-[1600px] items-end justify-between gap-4 px-5 sm:px-6 lg:px-10 xl:px-16">
					<h2 id="trending-heading" class="text-2xl font-extrabold text-ink sm:text-3xl">
						Trending now
					</h2>
					<a href="/trending/" class="inline-flex items-center gap-1 text-sm font-bold text-ink hover:text-primary">
						View all
						<Icon name="arrow-right" class="h-4 w-4" />
					</a>
				</div>
				<div
					class="mt-8 flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-4 sm:px-6 lg:px-10 xl:px-16 [&>*]:snap-start"
				>
					{trendingPosts.map((post, i) => (
						<div class="w-[280px] shrink-0 sm:w-[320px]">
							<PostCard post={post} delay={i * 60} />
						</div>
					))}
				</div>
			</section>
		)
	}

	<AlsoCheckOut posts={alsoCheckOutPosts} />

	<InfographicStrip
		articleCount={allPosts.length}
		categoryCount={categories.length}
		languageCount={14}
	/>

	<InfographicGallery />
</Layout>
