---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import Icon from "../../components/icons/Icon.astro";
import { textClass } from "../../lib/categoryStyles";

export async function getStaticPaths() {
	const categories = await getCollection("categories");
	return categories.map((category) => ({
		params: { category: category.data.slug },
		props: { category },
	}));
}

const { category } = Astro.props;
const posts = (await getCollection("posts", ({ data }) => !data.draft && data.category.id === category.id)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
	title={category.data.name}
	description={`${category.data.description} Browse every Bull or Bear Blogs article on ${category.data.name}.`}
>
	<section class="mx-auto max-w-5xl px-5 pb-6 pt-14 sm:px-6 sm:pt-20">
		<span class={`inline-flex items-center gap-2 text-sm font-bold ${textClass(category.data.accentColor)}`}>
			<Icon name={category.data.icon} class="h-5 w-5" />
			Topic
		</span>
		<h1 class="mt-3 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">{category.data.name}</h1>
		<p class="mt-4 max-w-2xl text-lg text-mute">{category.data.description}</p>
	</section>

	<section class="mx-auto max-w-[1600px] px-5 py-10 sm:px-6 lg:px-10 xl:px-16">
		{
			posts.length > 0 ? (
				<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
					{posts.map((post, i) => (
						<PostCard post={post} delay={i * 60} />
					))}
				</div>
			) : (
				<p class="text-mute">No articles here yet — check back soon.</p>
			)
		}
	</section>
</Layout>
