---
export interface Props {
	name: string;
	class?: string;
}

const { name, class: className = "" } = Astro.props;
---

<svg
	class={className}
	width="24"
	height="24"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{
		name === "search" && (
			<>
				<circle cx="11" cy="11" r="7" />
				<line x1="21" y1="21" x2="16.65" y2="16.65" />
			</>
		)
	}
	{
		name === "sun" && (
			<>
				<circle cx="12" cy="12" r="4.2" />
				<line x1="12" y1="1.8" x2="12" y2="4.2" />
				<line x1="12" y1="19.8" x2="12" y2="22.2" />
				<line x1="1.8" y1="12" x2="4.2" y2="12" />
				<line x1="19.8" y1="12" x2="22.2" y2="12" />
				<line x1="4.6" y1="4.6" x2="6.3" y2="6.3" />
				<line x1="17.7" y1="17.7" x2="19.4" y2="19.4" />
				<line x1="4.6" y1="19.4" x2="6.3" y2="17.7" />
				<line x1="17.7" y1="6.3" x2="19.4" y2="4.6" />
			</>
		)
	}
	{name === "moon" && <path d="M20.2 13.4A8.4 8.4 0 1 1 11 3.3a6.6 6.6 0 0 0 9.2 10.1Z" />}
	{
		name === "globe" && (
			<>
				<circle cx="12" cy="12" r="9" />
				<line x1="3" y1="12" x2="21" y2="12" />
				<ellipse cx="12" cy="12" rx="4" ry="9" />
			</>
		)
	}
	{
		name === "menu" && (
			<>
				<line x1="4" y1="6" x2="20" y2="6" />
				<line x1="4" y1="12" x2="20" y2="12" />
				<line x1="4" y1="18" x2="20" y2="18" />
			</>
		)
	}
	{
		name === "close" && (
			<>
				<line x1="5" y1="5" x2="19" y2="19" />
				<line x1="19" y1="5" x2="5" y2="19" />
			</>
		)
	}
	{name === "chevron-down" && <polyline points="6 9 12 15 18 9" />}
	{
		name === "share" && (
			<>
				<circle cx="6" cy="12" r="2.4" />
				<circle cx="18" cy="6" r="2.4" />
				<circle cx="18" cy="18" r="2.4" />
				<line x1="8.1" y1="10.8" x2="15.9" y2="7.2" />
				<line x1="8.1" y1="13.2" x2="15.9" y2="16.8" />
			</>
		)
	}
	{
		name === "link" && (
			<>
				<rect x="3" y="8" width="9" height="9" rx="3" transform="rotate(-20 7.5 12.5)" />
				<rect x="12" y="7" width="9" height="9" rx="3" transform="rotate(-20 16.5 11.5)" />
			</>
		)
	}
	{
		name === "mail" && (
			<>
				<rect x="3" y="5" width="18" height="14" rx="2" />
				<polyline points="3 7 12 13 21 7" />
			</>
		)
	}
	{name === "play" && <polygon points="8 5 19 12 8 19" fill="currentColor" stroke="none" />}
	{
		name === "pause" && (
			<>
				<rect x="7" y="5" width="4" height="14" rx="1" fill="currentColor" stroke="none" />
				<rect x="13" y="5" width="4" height="14" rx="1" fill="currentColor" stroke="none" />
			</>
		)
	}
	{name === "stop" && <rect x="6" y="6" width="12" height="12" rx="2" fill="currentColor" stroke="none" />}
	{
		name === "instagram" && (
			<>
				<rect x="3" y="3" width="18" height="18" rx="5" />
				<circle cx="12" cy="12" r="4.2" />
				<circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none" />
			</>
		)
	}
	{
		name === "youtube" && (
			<>
				<rect x="2" y="5" width="20" height="14" rx="4" />
				<polygon points="10 9 16 12 10 15" fill="currentColor" stroke="none" />
			</>
		)
	}
	{
		name === "facebook" && (
			<>
				<circle cx="12" cy="12" r="9" />
				<path
					d="M13.4 21v-6.6h2.2l.3-2.6h-2.5V10c0-.8.2-1.3 1.3-1.3h1.4V6.4c-.2 0-1.1-.1-2-.1-2.1 0-3.5 1.3-3.5 3.6v2h-2.3v2.6h2.3V21"
					fill="currentColor"
					stroke="none"
				/>
			</>
		)
	}
	{
		name === "threads" && (
			<>
				<circle cx="12" cy="12" r="9" />
				<path d="M9.5 8.5c3.6-1 6 .6 6 3.3 0 2.5-1.7 4.2-4 4.2-1.8 0-3-1-3-2.4 0-1.5 1.4-2.3 3.3-2.3 1 0 1.9.2 2.5.5" />
			</>
		)
	}
	{
		name === "x-social" && (
			<>
				<line x1="5" y1="5" x2="19" y2="19" stroke-width="2" />
				<line x1="19" y1="5" x2="5" y2="19" stroke-width="2" />
			</>
		)
	}
	{
		name === "cat-ai" && (
			<>
				<rect x="7" y="7" width="10" height="10" rx="2" />
				<rect x="10" y="10" width="4" height="4" />
				<line x1="9" y1="2.5" x2="9" y2="6.3" />
				<line x1="15" y1="2.5" x2="15" y2="6.3" />
				<line x1="9" y1="17.7" x2="9" y2="21.5" />
				<line x1="15" y1="17.7" x2="15" y2="21.5" />
				<line x1="2.5" y1="9" x2="6.3" y2="9" />
				<line x1="2.5" y1="15" x2="6.3" y2="15" />
				<line x1="17.7" y1="9" x2="21.5" y2="9" />
				<line x1="17.7" y1="15" x2="21.5" y2="15" />
			</>
		)
	}
	{
		name === "cat-tech" && (
			<>
				<polyline points="9 6 3 12 9 18" />
				<polyline points="15 6 21 12 15 18" />
			</>
		)
	}
	{
		name === "cat-money" && (
			<>
				<circle cx="9" cy="9" r="6" />
				<circle cx="15" cy="15" r="6" />
			</>
		)
	}
	{
		name === "cat-finance" && (
			<>
				<polyline points="3 16 9 10 13 14 21 5" />
				<polyline points="14 5 21 5 21 12" />
			</>
		)
	}
	{
		name === "cat-politics" && (
			<>
				<line x1="4" y1="21" x2="20" y2="21" />
				<polygon points="12 3 21 9 3 9" />
				<line x1="6" y1="9" x2="6" y2="19" />
				<line x1="10" y1="9" x2="10" y2="19" />
				<line x1="14" y1="9" x2="14" y2="19" />
				<line x1="18" y1="9" x2="18" y2="19" />
			</>
		)
	}
	{
		name === "cat-personal-finance" && (
			<>
				<rect x="3" y="6" width="18" height="13" rx="2" />
				<circle cx="17" cy="13" r="1.3" fill="currentColor" stroke="none" />
			</>
		)
	}
	{
		name === "cat-world" && (
			<>
				<circle cx="12" cy="12" r="9" />
				<path d="M3 9h18M3 15h18" />
				<path d="M12 3a13.5 13.5 0 0 1 0 18a13.5 13.5 0 0 1 0-18Z" />
			</>
		)
	}
	{
		name === "cat-business" && (
			<>
				<rect x="3" y="8" width="18" height="12" rx="2" />
				<path d="M8 8V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
				<line x1="3" y1="13" x2="21" y2="13" />
			</>
		)
	}
	{
		name === "cat-lifestyle" && (
			<>
				<path d="M12 20s-7-4.4-9.3-9A5.4 5.4 0 0 1 12 6.5A5.4 5.4 0 0 1 21.3 11c-2.3 4.6-9.3 9-9.3 9Z" />
			</>
		)
	}
	{
		name === "arrow-right" && (
			<>
				<line x1="5" y1="12" x2="19" y2="12" />
				<polyline points="12 5 19 12 12 19" />
			</>
		)
	}
	{
		name === "clock" && (
			<>
				<circle cx="12" cy="12" r="9" />
				<polyline points="12 7 12 12 16 14" />
			</>
		)
	}
	{
		name === "message-circle" && (
			<path d="M21 11.5a8.4 8.4 0 0 1-8.5 8.4 8.6 8.6 0 0 1-4-1L3 20l1.1-4.5A8.4 8.4 0 0 1 12.5 3.1a8.4 8.4 0 0 1 8.5 8.4Z" />
		)
	}
	{
		name === "headphones" && (
			<>
				<path d="M4 15v-3a8 8 0 0 1 16 0v3" />
				<rect x="3" y="15" width="4.2" height="6" rx="1.2" />
				<rect x="16.8" y="15" width="4.2" height="6" rx="1.2" />
			</>
		)
	}
	{
		name === "check" && (
			<polyline points="5 13 10 18 19 6" />
		)
	}
	{
		name === "calculator" && (
			<>
				<rect x="5" y="2.5" width="14" height="19" rx="2" />
				<line x1="8" y1="6.2" x2="16" y2="6.2" />
				<line x1="8.3" y1="10.3" x2="8.3" y2="10.3" stroke-width="2.6" />
				<line x1="12" y1="10.3" x2="12" y2="10.3" stroke-width="2.6" />
				<line x1="15.7" y1="10.3" x2="15.7" y2="10.3" stroke-width="2.6" />
				<line x1="8.3" y1="14" x2="8.3" y2="14" stroke-width="2.6" />
				<line x1="12" y1="14" x2="12" y2="14" stroke-width="2.6" />
				<line x1="15.7" y1="14" x2="15.7" y2="14" stroke-width="2.6" />
				<line x1="8.3" y1="17.7" x2="8.3" y2="17.7" stroke-width="2.6" />
				<line x1="12" y1="17.7" x2="15.7" y2="17.7" />
			</>
		)
	}
	{
		name === "image-stack" && (
			<>
				<rect x="2.5" y="6.5" width="15" height="15" rx="2" />
				<circle cx="8" cy="12" r="1.6" />
				<path d="m6 19 3.2-3.6a1.5 1.5 0 0 1 2.15-.1L13 17" />
				<path d="M7 3.5h11.5a2 2 0 0 1 2 2V16" />
			</>
		)
	}
	{
		name === "list" && (
			<>
				<line x1="9" y1="6" x2="20" y2="6" />
				<line x1="9" y1="12" x2="20" y2="12" />
				<line x1="9" y1="18" x2="20" y2="18" />
				<line x1="4" y1="6" x2="4" y2="6" stroke-width="2.6" />
				<line x1="4" y1="12" x2="4" y2="12" stroke-width="2.6" />
				<line x1="4" y1="18" x2="4" y2="18" stroke-width="2.6" />
			</>
		)
	}
</svg>
