---
import { getCollection } from "astro:content";
import Logo from "./Logo.astro";
import Icon from "./icons/Icon.astro";
import { siteConfig } from "../lib/siteConfig";

const categories = await getCollection("categories");
const year = new Date().getFullYear();

const socialLinks = [
	{ name: "Instagram", icon: "instagram", href: siteConfig.social.instagram },
	{ name: "YouTube", icon: "youtube", href: siteConfig.social.youtube },
	{ name: "Facebook", icon: "facebook", href: siteConfig.social.facebook },
	{ name: "Threads", icon: "threads", href: siteConfig.social.threads },
	{ name: "X", icon: "x-social", href: siteConfig.social.x },
];
---

<footer class="relative overflow-hidden border-t border-hairline bg-gradient-to-b from-canvas to-surface-soft">
	<!-- ambient gradient accents, theme-aware -->
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/50 to-transparent"></div>
		<div class="absolute -top-32 left-[-8%] h-64 w-64 rounded-full bg-primary/10 blur-3xl dark:bg-primary/20 sm:h-96 sm:w-96"></div>
		<div class="absolute -bottom-32 right-[-8%] h-64 w-64 rounded-full bg-[#7e238b]/10 blur-3xl dark:bg-[#c084fc]/15 sm:h-96 sm:w-96"></div>
	</div>

	<div class="relative mx-auto max-w-[1600px] px-5 py-14 sm:px-6 sm:py-16 lg:px-10 xl:px-16">
		<div
			class="reveal relative flex flex-col items-center gap-8 overflow-hidden rounded-[2rem] bg-gradient-to-br from-surface-dark via-surface-dark to-[#2a1016] px-6 py-10 sm:px-10 dark:to-[#1f0c11]"
		>
			<div class="pointer-events-none absolute -right-16 -top-16 z-0 h-56 w-56 rounded-full bg-primary/25 blur-3xl" aria-hidden="true"></div>
			<img
				src="/images/brand/bull-or-bear-daily-wordmark.png"
				alt="Bull or Bear Daily"
				class="relative z-10 h-16 w-auto sm:h-24"
				width="1024"
				height="352"
				loading="lazy"
			/>
			<div class="relative z-10 flex w-full flex-col items-center justify-between gap-6 text-center sm:flex-row sm:items-center sm:text-left">
			<div class="max-w-md">
				<h2 class="text-2xl font-extrabold text-on-dark sm:text-3xl">Never miss a signal.</h2>
				<p class="mt-2 text-sm text-on-dark/70">
					One email a week: the sharpest reads across AI, markets, and money. No noise.
				</p>
			</div>
			<div class="w-full max-w-sm">
				<form class="newsletter-form flex w-full flex-col gap-3 sm:flex-row" novalidate>
					<label class="sr-only" for="newsletter-email">Email address</label>
					<input
						id="newsletter-email"
						type="email"
						required
						placeholder="you@email.com"
						aria-describedby="newsletter-error"
						class="h-12 w-full rounded-full border-2 border-transparent bg-white/10 px-4 text-sm text-on-dark placeholder:text-on-dark/50 focus:bg-white/15 focus:outline-none aria-invalid:border-error-deep"
					/>
					<button
						type="submit"
						class="h-12 shrink-0 rounded-full bg-primary px-6 text-sm font-bold text-white transition-colors hover:bg-primary-pressed"
					>
						Subscribe
					</button>
				</form>
				<p id="newsletter-error" class="newsletter-error mt-2 hidden text-sm font-semibold text-error-deep" role="alert">
					Enter a valid email address (e.g. you@example.com).
				</p>
				<p class="newsletter-success hidden text-sm font-semibold text-on-dark">
					You're in. Watch your inbox. 🎉
				</p>
			</div>
			</div>
		</div>

		<div class="mt-14 grid grid-cols-1 gap-10 sm:grid-cols-2 sm:gap-8 lg:grid-cols-4">
			<div class="sm:col-span-2 lg:col-span-1">
				<Logo />
				<p class="mt-4 max-w-[26ch] text-sm text-mute">{siteConfig.tagline}</p>
				<div class="mt-5 flex items-center gap-2">
					{
						socialLinks.map((s) => (
							<a
								href={s.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={s.name}
								class="grid h-10 w-10 place-items-center rounded-full bg-surface-card text-ink transition-colors hover:bg-primary hover:text-white"
							>
								<Icon name={s.icon} class="h-4.5 w-4.5" />
							</a>
						))
					}
				</div>
			</div>

			<div>
				<h3 class="text-xs font-bold uppercase tracking-wide text-mute">Explore</h3>
				<ul class="mt-4 space-y-3 text-sm">
					<li><a href="/latest/" class="text-body hover:text-primary">Latest</a></li>
					<li><a href="/trending/" class="text-body hover:text-primary">Trending</a></li>
					<li><a href="/search/" class="text-body hover:text-primary">Search</a></li>
					<li><a href="/about/" class="text-body hover:text-primary">About</a></li>
					<li><a href="/contact/" class="text-body hover:text-primary">Contact</a></li>
				</ul>
			</div>

			<div>
				<h3 class="text-xs font-bold uppercase tracking-wide text-mute">Topics</h3>
				<ul class="mt-4 space-y-3 text-sm">
					{
						categories.map((cat) => (
							<li>
								<a href={`/${cat.data.slug}/`} class="text-body hover:text-primary">
									{cat.data.name}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h3 class="text-xs font-bold uppercase tracking-wide text-mute">Legal</h3>
				<ul class="mt-4 space-y-3 text-sm">
					<li><a href="/privacy/" class="text-body hover:text-primary">Privacy Policy</a></li>
					<li><a href="/terms/" class="text-body hover:text-primary">Terms and Conditions</a></li>
					<li><a href="/editorial-policy/" class="text-body hover:text-primary">Editorial Policy</a></li>
					<li><a href="/disclaimer/" class="text-body hover:text-primary">Disclaimer</a></li>
				</ul>
			</div>
		</div>

		<div class="mt-14 select-none overflow-hidden text-center" aria-hidden="true">
			<p
				class="whitespace-nowrap bg-gradient-to-b from-ink/70 to-transparent bg-clip-text text-[clamp(2.75rem,13vw,9rem)] font-bold uppercase leading-none tracking-tighter text-transparent"
			>
				Bull or Bear
			</p>
		</div>

		<div
			class="mt-2 flex flex-col items-center justify-between gap-3 border-t border-hairline pt-6 text-xs text-mute sm:flex-row"
		>
			<p>© {year} {siteConfig.name}. All rights reserved.</p>
			<p>Built for readers who think in both directions.</p>
		</div>
	</div>
</footer>

<script>
	const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

	const form = document.querySelector<HTMLFormElement>(".newsletter-form");
	const input = form?.querySelector<HTMLInputElement>("#newsletter-email");
	const error = document.querySelector<HTMLElement>(".newsletter-error");

	form?.addEventListener("submit", (e) => {
		e.preventDefault();
		const value = input?.value.trim() ?? "";

		if (!EMAIL_PATTERN.test(value)) {
			error?.classList.remove("hidden");
			input?.setAttribute("aria-invalid", "true");
			input?.focus();
			return;
		}

		error?.classList.add("hidden");
		input?.removeAttribute("aria-invalid");
		form.classList.add("hidden");
		document.querySelector(".newsletter-success")?.classList.remove("hidden");
	});

	input?.addEventListener("input", () => {
		if (!error?.classList.contains("hidden")) {
			error.classList.add("hidden");
			input.removeAttribute("aria-invalid");
		}
	});
</script>
