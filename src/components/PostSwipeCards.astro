---
export interface Props {
	heading?: string;
	items: { label: string; title: string; body: string }[];
}

const { heading = "1 min read", items } = Astro.props;
---

<div class="not-prose my-8 space-y-3" data-post-swipe>
	<div class="flex items-center justify-between">
		<p class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-wide text-mute">
			<span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
			{heading}
		</p>
		<div class="flex items-center gap-1.5">
			<button
				type="button"
				data-swipe-prev
				aria-label="Previous card"
				disabled
				class="grid h-8 w-8 place-items-center rounded-full border border-hairline text-ink transition-opacity disabled:opacity-30"
			>
				‹
			</button>
			<button
				type="button"
				data-swipe-next
				aria-label="Next card"
				class="grid h-8 w-8 place-items-center rounded-full border border-hairline text-ink transition-opacity disabled:opacity-30"
			>
				›
			</button>
		</div>
	</div>

	<div class="relative overflow-hidden">
		<div data-swipe-track class="flex touch-pan-y transition-transform duration-300 ease-out">
			{
				items.map((item) => (
					<div class="w-full shrink-0 px-1">
						<div class="h-full rounded-2xl border border-hairline bg-surface-card p-5">
							<span class="inline-block rounded-full bg-canvas px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-primary">
								{item.label}
							</span>
							<p class="mt-3 text-base font-bold text-ink">{item.title}</p>
							<p class="mt-1.5 text-sm leading-relaxed text-mute">{item.body}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>

	<div data-swipe-dots class="flex items-center justify-center gap-1.5">
		{items.map((_, i) => <span class="h-1.5 w-1.5 rounded-full bg-hairline" data-dot-index={i} />)}
	</div>
</div>

<script>
	/**
	 * translateX must be a real per-card pixel offset measured from layout
	 * (cards[i].offsetLeft), not an assumed -100%*i — that percentage is
	 * relative to the whole track's width (N cards wide, since every card
	 * is min-w-full/shrink-0), not one card, so it massively overshoots
	 * past the first "next" click once there's more than one card.
	 */
	function initSwipeCards(root: HTMLElement) {
		const track = root.querySelector<HTMLElement>("[data-swipe-track]");
		const prevBtn = root.querySelector<HTMLButtonElement>("[data-swipe-prev]");
		const nextBtn = root.querySelector<HTMLButtonElement>("[data-swipe-next]");
		const dots = [...root.querySelectorAll<HTMLElement>("[data-dot-index]")];
		if (!track || !prevBtn || !nextBtn) return;

		const cards = [...track.children] as HTMLElement[];
		if (cards.length === 0) return;

		let index = 0;

		function offsetFor(i: number): number {
			return cards[i].offsetLeft - cards[0].offsetLeft;
		}

		function render() {
			track!.style.transform = `translateX(-${offsetFor(index)}px)`;
			prevBtn!.disabled = index === 0;
			nextBtn!.disabled = index === cards.length - 1;
			dots.forEach((dot, i) => {
				dot.classList.toggle("bg-primary", i === index);
				dot.classList.toggle("bg-hairline", i !== index);
			});
		}

		prevBtn.addEventListener("click", () => {
			index = Math.max(0, index - 1);
			render();
		});
		nextBtn.addEventListener("click", () => {
			index = Math.min(cards.length - 1, index + 1);
			render();
		});

		let dragging = false;
		let startX = 0;
		track.addEventListener("pointerdown", (e) => {
			dragging = true;
			startX = e.clientX;
		});
		window.addEventListener("pointerup", (e) => {
			if (!dragging) return;
			dragging = false;
			const delta = e.clientX - startX;
			if (delta > 40) prevBtn.click();
			else if (delta < -40) nextBtn.click();
		});

		window.addEventListener("resize", render);
		render();
	}

	document.querySelectorAll<HTMLElement>("[data-post-swipe]").forEach(initSwipeCards);
</script>
