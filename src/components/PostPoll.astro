---
export interface Props {
	id: string;
	label?: string;
	question: string;
	options: string[];
}

const { id, label = "Quick poll", question, options } = Astro.props;
---

<div class="not-prose my-8 rounded-2xl border border-hairline bg-surface-card p-5" data-post-poll data-poll-id={id}>
	<p class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-wide text-mute">
		<span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
		{label}
	</p>
	<p class="mt-2 text-base font-bold text-ink">{question}</p>
	<div class="mt-3 grid gap-2" role="radiogroup" aria-label={question}>
		{
			options.map((opt, i) => (
				<button
					type="button"
					data-poll-option
					data-option-index={i}
					role="radio"
					aria-checked="false"
					class="poll-option flex items-center gap-2.5 rounded-xl border-2 border-hairline bg-canvas px-3.5 py-2.5 text-left text-sm font-semibold text-ink transition-colors"
				>
					<span class="poll-option__marker h-4 w-4 shrink-0 rounded-full border-2 border-hairline" />
					{opt}
				</button>
			))
		}
	</div>
	<p data-poll-ack class="mt-2 hidden text-xs font-semibold text-mute">
		Thanks for weighing in — this just highlights your own pick, no results are shown.
	</p>
</div>

<script>
	/**
	 * No vote-count/seed-data prop at all — this only ever highlights the
	 * current visitor's own click, never a claimed aggregate like "42% of
	 * readers said…" (CLAUDE.md: never fabricate facts).
	 */
	function initPoll(root: HTMLElement) {
		const pollId = root.dataset.pollId ?? "poll";
		const storageKey = `bob-post-poll-${window.location.pathname}-${pollId}`;
		const options = [...root.querySelectorAll<HTMLButtonElement>("[data-poll-option]")];
		const ack = root.querySelector<HTMLElement>("[data-poll-ack]");

		function select(index: number, persist: boolean) {
			options.forEach((btn, i) => {
				const isSelected = i === index;
				btn.classList.toggle("is-selected", isSelected);
				btn.setAttribute("aria-checked", String(isSelected));
			});
			ack?.classList.remove("hidden");
			if (persist) localStorage.setItem(storageKey, String(index));
		}

		options.forEach((btn) => {
			btn.addEventListener("click", () => {
				const index = Number(btn.dataset.optionIndex ?? "-1");
				if (index < 0) return;
				select(index, true);
			});
		});

		const stored = localStorage.getItem(storageKey);
		if (stored !== null) select(Number(stored), false);
	}

	document.querySelectorAll<HTMLElement>("[data-post-poll]").forEach(initPoll);
</script>

<style>
	.poll-option.is-selected {
		border-color: var(--color-ink);
	}
	.poll-option.is-selected .poll-option__marker {
		border-color: var(--color-ink);
		background: var(--color-ink);
	}
</style>
