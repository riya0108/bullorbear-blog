---
import type { CollectionEntry } from "astro:content";
import Icon from "./icons/Icon.astro";
import { textClass } from "../lib/categoryStyles";

export interface Props {
	category: CollectionEntry<"categories">;
	delay?: number;
}

const { category, delay = 0 } = Astro.props;
---

<a
	href={`/${category.data.slug}/`}
	data-reveal-delay={delay}
	class="reveal group flex flex-col justify-between gap-8 rounded-[2rem] bg-surface-card p-6 transition-transform duration-300 hover:-translate-y-1 sm:p-8"
>
	<div class={`grid h-12 w-12 place-items-center rounded-full bg-canvas ${textClass(category.data.accentColor)}`}>
		<Icon name={category.data.icon} class="h-6 w-6" />
	</div>
	<div>
		<h3 class="text-xl font-bold text-ink">{category.data.name}</h3>
		<p class="mt-1.5 text-sm text-mute">{category.data.description}</p>
	</div>
	<span
		class="inline-flex items-center gap-1 text-sm font-bold text-ink transition-[gap] duration-200 group-hover:gap-2"
	>
		Explore
		<Icon name="arrow-right" class="h-4 w-4" />
	</span>
</a>
