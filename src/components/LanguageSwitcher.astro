---
import Icon from "./icons/Icon.astro";
import { languages } from "../lib/i18n";

// Header renders this component twice (desktop nav + mobile menu), so the
// select needs a unique id per instance rather than a hardcoded one —
// otherwise both would share the same id and only the first would ever get
// wired up by document.getElementById.
const uid = crypto.randomUUID();
const selectId = `lang-select-${uid}`;
---

<div class="relative shrink-0">
	<label class="sr-only" for={selectId}>Translate this page</label>
	<div
		class="flex h-10 items-center gap-1.5 rounded-full bg-surface-card pl-3 pr-2 text-ink transition-colors hover:bg-secondary-bg"
	>
		<Icon name="globe" class="h-4 w-4 shrink-0" />
		<select
			id={selectId}
			data-lang-select
			class="notranslate h-full cursor-pointer appearance-none bg-transparent pr-5 text-sm font-semibold outline-none disabled:cursor-wait disabled:opacity-60"
		>
			{languages.map((l) => <option value={l.code}>{l.label}</option>)}
		</select>
	</div>
</div>

<script>
	import { currentPageLanguage, setPageLanguage } from "../lib/i18n";

	// Every instance of this component on the page (desktop + mobile) shares
	// this one module-scoped script (Astro dedupes identical component
	// scripts), so wire up all of them here and keep them in sync.
	// worker-configuration.d.ts (Cloudflare's generated Workers types) augments
	// the global `Element` interface, which breaks TypeScript's usual
	// HTMLElement → HTMLSelectElement narrowing here — route through `unknown`.
	const selects = Array.from(
		document.querySelectorAll("[data-lang-select]"),
	) as unknown as HTMLSelectElement[];

	// Guards against firing a second language switch while one is still in
	// flight — doing so left Google Translate's hidden control in an
	// inconsistent state where the visible text stopped matching whatever
	// language was actually selected.
	let switching = false;

	selects.forEach((select) => {
		select.value = currentPageLanguage();
		select.addEventListener("change", () => {
			if (switching) return;
			const target = select.value;
			switching = true;
			selects.forEach((other) => {
				other.value = target;
				other.disabled = true;
			});
			void setPageLanguage(target).finally(() => {
				switching = false;
				selects.forEach((other) => {
					other.disabled = false;
				});
				window.dispatchEvent(new CustomEvent("bob:language-changed", { detail: { lang: target } }));
			});
		});
	});

	// Load the Google Translate widget lazily; it only needs to exist so the
	// googtrans cookie set above actually takes effect on this page.
	if (!(window as any).google?.translate) {
		(window as any).googleTranslateElementInit = function () {
			new (window as any).google.translate.TranslateElement(
				{ pageLanguage: "en", autoDisplay: false },
				"google_translate_element",
			);
		};
		const script = document.createElement("script");
		script.src = "https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit";
		script.async = true;
		document.body.appendChild(script);
	}
</script>
