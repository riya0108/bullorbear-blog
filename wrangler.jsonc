{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bullorbear-blog",
	"compatibility_date": "2026-08-01",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page"
	},
	"routes": [
		{ "pattern": "bullorbear.in", "custom_domain": true, "zone_name": "bullorbear.in" },
		{ "pattern": "www.bullorbear.in", "custom_domain": true, "zone_name": "bullorbear.in" }
	],
	"observability": {
		"enabled": true
	},
	"ratelimits": [
		{
			"name": "COMMENTS_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			"name": "POLL_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 10, "period": 60 }
		}
	]
}
